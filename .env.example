# Supabase Configuration
# Get these from your Supabase project: Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# For server-side scripts (migration, admin)
# Get this from Supabase: Settings > API > service_role key (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# OpenAI Configuration (for AI Chat)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Resend Configuration (for sending emails)
# Get from: https://resend.com/api-keys
RESEND_API_KEY=re_your-resend-key-here
FROM_EMAIL=Portfolio <hello@klimdushkin.design>
ADMIN_EMAIL=hello@klimdushkin.design

# Optional: Auto-reply to contact form submissions
AUTO_REPLY_ENABLED=true